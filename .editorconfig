root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
max_line_length = 100

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_prefer_braces = true:error
csharp_indent_case_contents = true

dotnet_sort_system_directives_first = true

csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion

dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0055.severity = warning

dotnet_naming_rule.priv_underscore.symbols = priv_field
dotnet_naming_rule.priv_underscore.style = underscore_camel
dotnet_naming_rule.priv_underscore.severity = warning

dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal_case_style
dotnet_naming_rule.constants_pascal.severity = warning

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_symbols.priv_field.applicable_kinds = field
dotnet_naming_symbols.priv_field.applicable_accessibilities = private

dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# StyleCop: свідомо вимкнені правила

# Заголовок з ліцензією в навчальному проєкті не потрібен
dotnet_diagnostic.SA1633.severity = none

# Префікс this. суперечить конвенції .NET
dotnet_diagnostic.SA1101.severity = none

# using поза namespace — стандарт шаблонів .NET
dotnet_diagnostic.SA1200.severity = none

# Приватні поля іменуємо з _, як прийнято в .NET
dotnet_diagnostic.SA1309.severity = none

# XML-документація
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1600.severity = warning
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none

# XML-документація пишеться українською
dotnet_diagnostic.SA1623.severity = none

# Кома в кінці багаторядкового ініціалізатора необов'язкова
dotnet_diagnostic.SA1413.severity = none

# Правила, які лишаємо суворими
dotnet_diagnostic.SA1028.severity = warning
dotnet_diagnostic.SA1201.severity = warning
dotnet_diagnostic.SA1503.severity = warning
dotnet_diagnostic.SA1516.severity = warning

# CA1305: Parse/ToString без культури
dotnet_diagnostic.CA1305.severity = suggestion

# XML-документація публічних членів Core обов'язкова
[LibraryDesk.Core/**/*.cs]
dotnet_diagnostic.CS1591.severity = error

# У тестах XML-документація не обов'язкова
[LibraryDesk.Tests/**/*.cs]
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.CA1707.severity = none

# CA1031: верхній обробник у Program.cs
[LibraryDesk.App/Program.cs]
dotnet_diagnostic.CA1031.severity = none

dotnet_diagnostic.CA1502.severity = warning

# XML documentation rules
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1642.severity = none

# Налаштування діагностики для успішної збірки
[*.cs]
dotnet_diagnostic.CS1573.severity = none
dotnet_diagnostic.SA1503.severity = none
dotnet_diagnostic.SA1514.severity = none
dotnet_diagnostic.SA1518.severity = none
dotnet_diagnostic.SA1116.severity = none
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1202.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1210.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1642.severity = none

# Додаткові правила для збірки App
[*.cs]
dotnet_diagnostic.SA1501.severity = none
dotnet_diagnostic.SA1107.severity = none
